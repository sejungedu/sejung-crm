<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>세정학원 CRM · Aca2000 MSSQL → Supabase ETL 하루 1회 동기화 · 매일 08:00 KST</Description>
    <URI>\Sejung\CRM-ETL-Daily</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <!-- 2026-09-22 하루 1회로 변경 (이전: 09:00~24:00 30분 반복). 시각을 바꾸려면 StartBoundary 의 시간만 고친다. -->
      <StartBoundary>2026-09-22T08:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <!-- 이전 실행이 안 끝났으면 새 실행 무시 (중복 발사 차단) -->
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>false</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>true</WakeToRun>
    <!-- ETL 1회 평균 5~20분. 하루 1회라 다음 실행과 겹칠 일은 없지만 무한 대기는 막는다. -->
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>cmd.exe</Command>
      <!-- README-windows.md 안내대로 C:\sejung-crm 에 clone 했다면 import 만 하면 됨.
           다른 경로면 아래 두 줄의 C:\sejung-crm 를 실제 경로로 바꿀 것. -->
      <Arguments>/c "C:\sejung-crm\scripts\etl\run_all.bat"</Arguments>
      <WorkingDirectory>C:\sejung-crm</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
